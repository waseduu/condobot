{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "aptPackages": ["chromium", "libxshmfence-dev", "nss", "nspr", "atk-bridge2.0-0", "libdrm2", "libgbm1", "libasound2"]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
