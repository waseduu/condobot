<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CondoBot - Moradores</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0"><i class="bi bi-people me-2"></i>Moradores</h2>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovo">
        <i class="bi bi-person-plus"></i> Novo
      </button>
    </div>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <form method="GET" class="row g-2 align-items-end">
          <div class="col-12 col-md-6">
            <input type="text" name="busca" class="form-control" placeholder="Buscar por nome, lote ou telefone..." value="<%= busca %>">
          </div>
          <div class="col-6 col-md-3">
            <select name="ativo" class="form-select">
              <option value="">Todos</option>
              <option value="1" <%= filtroAtivo === '1' ? 'selected' : '' %>>Ativos</option>
              <option value="0" <%= filtroAtivo === '0' ? 'selected' : '' %>>Inativos</option>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <button class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Filtrar</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Lote</th>
              <th>Telefone</th>
              <th>Status</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (moradores.length === 0) { %>
              <tr><td colspan="5" class="text-center text-body-secondary py-4">Nenhum morador encontrado</td></tr>
            <% } %>
            <% moradores.forEach(m => { %>
            <tr>
              <td><%= m.nome %></td>
              <td><%= m.lote %></td>
              <td><%= m.telefone || '-' %></td>
              <td>
                <span class="badge bg-<%= m.ativo ? 'success' : 'secondary' %>">
                  <%= m.ativo ? 'Ativo' : 'Inativo' %>
                </span>
              </td>
              <td class="text-end">
                <button class="btn btn-sm btn-outline-info" onclick="editarMorador(<%= m.id %>)" title="Editar">
                  <i class="bi bi-pencil"></i>
                </button>
                <form method="POST" action="/moradores/excluir/<%= m.id %>" class="d-inline" onsubmit="return confirm('Excluir este morador?')">
                  <button class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Novo -->
  <div class="modal fade" id="modalNovo" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/moradores">
          <div class="modal-header">
            <h5 class="modal-title">Novo Morador</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Nome *</label>
              <input type="text" name="nome" class="form-control" required>
            </div>
            <div class="row mb-3">
              <div class="col-6">
                <label class="form-label">Lote *</label>
                <input type="text" name="lote" class="form-control" required>
              </div>
              <div class="col-6">
                <label class="form-label">Telefone</label>
                <input type="text" name="telefone" class="form-control" placeholder="(11) 99999-9999">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Observações</label>
              <textarea name="observacoes" class="form-control" rows="2"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Editar -->
  <div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" id="formEditar">
          <div class="modal-header">
            <h5 class="modal-title">Editar Morador</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Nome *</label>
              <input type="text" name="nome" id="editNome" class="form-control" required>
            </div>
            <div class="row mb-3">
              <div class="col-6">
                <label class="form-label">Lote *</label>
                <input type="text" name="lote" id="editLote" class="form-control" required>
              </div>
              <div class="col-6">
                <label class="form-label">Telefone</label>
                <input type="text" name="telefone" id="editTelefone" class="form-control">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Observações</label>
              <textarea name="observacoes" id="editObservacoes" class="form-control" rows="2"></textarea>
            </div>
            <div class="form-check">
              <input type="checkbox" name="ativo" id="editAtivo" class="form-check-input" checked>
              <label class="form-check-label">Ativo</label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    async function editarMorador(id) {
      const res = await fetch('/moradores/dados/' + id);
      const m = await res.json();
      document.getElementById('editNome').value = m.nome;
      document.getElementById('editLote').value = m.lote;
      document.getElementById('editTelefone').value = m.telefone || '';
      document.getElementById('editObservacoes').value = m.observacoes || '';
      document.getElementById('editAtivo').checked = m.ativo === 1;
      document.getElementById('formEditar').action = '/moradores/editar/' + id;
      new bootstrap.Modal(document.getElementById('modalEditar')).show();
    }
  </script>
</body>
</html>
