<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CondoBot - Financeiro</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0"><i class="bi bi-wallet2 me-2"></i>Controle Financeiro</h2>
      <div>
        <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#modalEntrada">
          <i class="bi bi-plus-circle"></i> Entrada
        </button>
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalSaida">
          <i class="bi bi-dash-circle"></i> Saída
        </button>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Contribuições</small>
            <h4 class="text-success mb-0"><%= contribPago.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h4>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Outras Entradas</small>
            <h4 class="text-success mb-0"><%= totalEntradas.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h4>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Saídas</small>
            <h4 class="text-danger mb-0"><%= totalSaidas.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h4>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Saldo</small>
            <h4 class="text-<%= saldo >= 0 ? 'success' : 'danger' %> mb-0"><%= saldo.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h4>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header"><i class="bi bi-box-arrow-in-right text-success me-2"></i>Entradas</div>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead>
                <tr><th>Data</th><th>Descrição</th><th>Valor</th><th>Categoria</th><th></th></tr>
              </thead>
              <tbody>
                <% if (entradas.length === 0) { %>
                  <tr><td colspan="5" class="text-center text-body-secondary py-3">Nenhuma entrada</td></tr>
                <% } %>
                <% entradas.forEach(e => { %>
                <tr>
                  <td><%= e.data %></td>
                  <td><%= e.descricao %></td>
                  <td class="text-success"><%= e.valor.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></td>
                  <td><span class="badge bg-info"><%= e.categoria %></span></td>
                  <td>
                    <form method="POST" action="/financeiro/entrada/excluir/<%= e.id %>" class="d-inline" onsubmit="return confirm('Excluir?')">
                      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header"><i class="bi bi-box-arrow-out-right text-danger me-2"></i>Saídas</div>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead>
                <tr><th>Data</th><th>Descrição</th><th>Valor</th><th>Categoria</th><th></th></tr>
              </thead>
              <tbody>
                <% if (saidas.length === 0) { %>
                  <tr><td colspan="5" class="text-center text-body-secondary py-3">Nenhuma saída</td></tr>
                <% } %>
                <% saidas.forEach(s => { %>
                <tr>
                  <td><%= s.data %></td>
                  <td><%= s.descricao %></td>
                  <td class="text-danger">-<%= s.valor.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></td>
                  <td><span class="badge bg-warning"><%= s.categoria %></span></td>
                  <td>
                    <form method="POST" action="/financeiro/saida/excluir/<%= s.id %>" class="d-inline" onsubmit="return confirm('Excluir?')">
                      <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                    </form>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Entrada -->
  <div class="modal fade" id="modalEntrada" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/financeiro/entrada">
          <div class="modal-header">
            <h5 class="modal-title">Nova Entrada</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Descrição *</label>
              <input type="text" name="descricao" class="form-control" required>
            </div>
            <div class="row mb-3">
              <div class="col-6">
                <label class="form-label">Valor (R$) *</label>
                <input type="number" name="valor" class="form-control" step="0.01" required>
              </div>
              <div class="col-6">
                <label class="form-label">Data *</label>
                <input type="date" name="data" class="form-control" required value="<%= new Date().toISOString().slice(0,10) %>">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Categoria</label>
              <select name="categoria" class="form-select">
                <option>Outras</option>
                <option>Doação</option>
                <option>Evento</option>
                <option>Multa</option>
                <option>Inscrição</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Observações</label>
              <textarea name="observacoes" class="form-control" rows="2"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-success">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Saída -->
  <div class="modal fade" id="modalSaida" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/financeiro/saida">
          <div class="modal-header">
            <h5 class="modal-title">Nova Saída</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Descrição *</label>
              <input type="text" name="descricao" class="form-control" required>
            </div>
            <div class="row mb-3">
              <div class="col-6">
                <label class="form-label">Valor (R$) *</label>
                <input type="number" name="valor" class="form-control" step="0.01" required>
              </div>
              <div class="col-6">
                <label class="form-label">Data *</label>
                <input type="date" name="data" class="form-control" required value="<%= new Date().toISOString().slice(0,10) %>">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Categoria</label>
              <select name="categoria" class="form-select">
                <option>Outras</option>
                <option>Água</option>
                <option>Luz</option>
                <option>Limpeza</option>
                <option>Manutenção</option>
                <option>Evento</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Observações</label>
              <textarea name="observacoes" class="form-control" rows="2"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-danger">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
