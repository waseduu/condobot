<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CondoBot - Contribuições</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Contribuições</h2>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalRegistrar">
        <i class="bi bi-plus-circle"></i> Registrar
      </button>
    </div>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert alert-danger"><%= erro %></div>
    <% } %>
    <% if (typeof wpp_enviado !== 'undefined' && wpp_enviado) { %>
      <div class="alert alert-success">Lembrete enviado com sucesso!</div>
    <% } %>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <form method="GET" class="row g-2 align-items-end">
          <div class="col-6 col-md-3">
            <select name="mes" class="form-select">
              <option value="">Todos os meses</option>
              <% meses.forEach(m => { %>
                <option value="<%= m %>" <%= filtroMes === m ? 'selected' : '' %>><%= m %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <select name="status" class="form-select">
              <option value="">Todos status</option>
              <option value="Pago" <%= filtroStatus === 'Pago' ? 'selected' : '' %>>Pago</option>
              <option value="Pendente" <%= filtroStatus === 'Pendente' ? 'selected' : '' %>>Pendente</option>
            </select>
          </div>
          <div class="col-6 col-md-4">
            <select name="morador_id" class="form-select">
              <option value="">Todos moradores</option>
              <% moradores.forEach(m => { %>
                <option value="<%= m.id %>" <%= String(filtroMorador) === String(m.id) ? 'selected' : '' %>><%= m.nome %> - <%= m.lote %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-6 col-md-2">
            <button class="btn btn-outline-primary w-100"><i class="bi bi-filter"></i> Filtrar</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Morador</th>
              <th>Lote</th>
              <th>Mês</th>
              <th>Valor</th>
              <th>Status</th>
              <th>Data Pagamento</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (contribuicoes.length === 0) { %>
              <tr><td colspan="7" class="text-center text-body-secondary py-4">Nenhuma contribuição encontrada</td></tr>
            <% } %>
            <% contribuicoes.forEach(c => { %>
            <tr>
              <td><%= c.morador_nome %></td>
              <td><%= c.morador_lote %></td>
              <td><%= c.mes_referencia %></td>
              <td><%= c.valor.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></td>
              <td>
                <span class="badge bg-<%= c.status === 'Pago' ? 'success' : 'warning' %>">
                  <%= c.status %>
                </span>
              </td>
              <td><%= c.data_pagamento || '-' %></td>
              <td class="text-end">
                <% if (c.status === 'Pendente' || c.status === 'Aguardando PIX') { %>
                  <button class="btn btn-sm btn-outline-primary" onclick="gerarPix(<%= c.id %>)" title="Gerar PIX copia e cola">
                    <i class="bi bi-qr-code"></i>
                  </button>
                  <button class="btn btn-sm btn-outline-info" onclick="gerarPixMp(<%= c.id %>)" title="Cobrar via Mercado Pago">
                    <i class="bi bi-lightning-charge"></i>
                  </button>
                  <form method="POST" action="/integracoes/whatsapp/lembrete/<%= c.id %>" class="d-inline">
                    <button class="btn btn-sm btn-outline-success" title="Enviar lembrete WhatsApp">
                      <i class="bi bi-whatsapp"></i>
                    </button>
                  </form>
                  <button class="btn btn-sm btn-success" onclick="pagar(<%= c.id %>)" title="Registrar pagamento">
                    <i class="bi bi-check-lg"></i>
                  </button>
                <% } else { %>
                  <form method="POST" action="/contribuicoes/estornar/<%= c.id %>" class="d-inline">
                    <button class="btn btn-sm btn-warning" title="Estornar"><i class="bi bi-arrow-counterclockwise"></i></button>
                  </form>
                <% } %>
                <form method="POST" action="/contribuicoes/excluir/<%= c.id %>" class="d-inline" onsubmit="return confirm('Excluir esta contribuição?')">
                  <button class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal Registrar -->
  <div class="modal fade" id="modalRegistrar" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" action="/contribuicoes/registrar">
          <div class="modal-header">
            <h5 class="modal-title">Registrar Contribuição</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Morador *</label>
              <select name="morador_id" class="form-select" required>
                <option value="">Selecione...</option>
                <% moradores.forEach(m => { %>
                  <option value="<%= m.id %>"><%= m.nome %> - <%= m.lote %></option>
                <% }) %>
              </select>
            </div>
            <div class="row mb-3">
              <div class="col-6">
                <label class="form-label">Mês de Referência *</label>
                <input type="month" name="mes_referencia" class="form-control" required value="<%= new Date().toISOString().slice(0,7) %>">
              </div>
              <div class="col-6">
                <label class="form-label">Valor (R$)</label>
                <input type="number" name="valor" class="form-control" step="0.01" value="100">
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-6">
                <label class="form-label">Data de Pagamento</label>
                <input type="date" name="data_pagamento" class="form-control">
              </div>
              <div class="col-6">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                  <option value="Pendente">Pendente</option>
                  <option value="Pago">Pago</option>
                </select>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Pagamento -->
  <div class="modal fade" id="modalPagar" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="POST" id="formPagar">
          <div class="modal-header">
            <h5 class="modal-title">Registrar Pagamento</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Data do Pagamento</label>
              <input type="date" name="data_pagamento" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-success">Confirmar Pagamento</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal PIX QR Code -->
  <div class="modal fade" id="modalPix" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-qr-code me-2"></i>PIX Copia e Cola</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body text-center">
          <div id="pixQrCode" class="mb-3">
            <div class="bg-white d-inline-block p-2 rounded" id="pixQrContainer"></div>
          </div>
          <div class="mb-3">
            <label class="form-label text-body-secondary">Código PIX Copia e Cola</label>
            <div class="input-group">
              <textarea id="pixPayload" class="form-control" rows="3" readonly style="font-size:0.75rem;word-break:break-all;"></textarea>
              <button class="btn btn-outline-info" onclick="copiarPix()"><i class="bi bi-clipboard"></i> Copiar</button>
            </div>
          </div>
          <div class="alert alert-info py-2">
            <i class="bi bi-info-circle me-1"></i> Após o pagamento, o sistema atualizará automaticamente quando receber a confirmação.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
  <script>
    let currentPixId = null;

    function pagar(id) {
      document.getElementById('formPagar').action = '/contribuicoes/pagar/' + id;
      new bootstrap.Modal(document.getElementById('modalPagar')).show();
    }

    async function gerarPix(id) {
      try {
        const res = await fetch('/integracoes/pix/gerar/' + id);
        if (!res.ok) {
          const err = await res.json();
          alert('Erro: ' + err.error);
          return;
        }
        const data = await res.json();
        currentPixId = id;
        document.getElementById('pixPayload').value = data.payload;

        const container = document.getElementById('pixQrContainer');
        container.innerHTML = '';
        new QRCode(container, {
          text: data.payload,
          width: 200,
          height: 200,
          correctLevel: QRCode.CorrectLevel.M
        });

        new bootstrap.Modal(document.getElementById('modalPix')).show();
      } catch (err) {
        alert('Erro ao gerar PIX: ' + err.message);
      }
    }

    function copiarPix() {
      const payload = document.getElementById('pixPayload');
      payload.select();
      navigator.clipboard.writeText(payload.value).then(() => {
        alert('Código PIX copiado!');
      });
    }

    async function gerarPixMp(id) {
      try {
        const res = await fetch('/integracoes/mercadopago/criar/' + id, { method: 'POST' });
        const data = await res.json();
        if (data.error) {
          alert('Erro: ' + data.error);
          return;
        }
        const texto = [
          'PIX gerado via Mercado Pago!',
          '',
          'Valor: R$ ' + data.valor.toFixed(2),
          'Status: ' + data.status,
          '',
          data.copiaECola ? 'Copia e Cola: ' + data.copiaECola : '',
          data.ticketUrl ? 'Link: ' + data.ticketUrl : ''
        ].filter(Boolean).join('\n');
        alert(texto);
        if (data.copiaECola) {
          navigator.clipboard.writeText(data.copiaECola).then(() => {
            alert('Código PIX copiado!');
          });
        }
        location.reload();
      } catch (err) {
        alert('Erro ao gerar PIX no Mercado Pago: ' + err.message);
      }
    }
  </script>
</body>
</html>
