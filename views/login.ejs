<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CondoBot - Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-body-tertiary">
  <div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
      <div class="col-md-5 col-lg-4">
        <div class="text-center mb-4">
          <i class="bi bi-building fs-1 text-primary"></i>
          <h1 class="h3 mt-2">CondoBot</h1>
          <p class="text-body-secondary">Gestão da Associação de Moradores</p>
        </div>
        <div class="card shadow-sm">
          <div class="card-body p-4">
            <h5 class="card-title text-center mb-4">Entrar</h5>
            <% if (error) { %>
              <div class="alert alert-danger py-2"><%= error %></div>
            <% } %>
            <form method="POST" action="/login">
              <div class="mb-3">
                <label class="form-label">Usuário</label>
                <input type="text" name="username" class="form-control" required autofocus>
              </div>
              <div class="mb-3">
                <label class="form-label">Senha</label>
                <input type="password" name="password" class="form-control" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">Entrar</button>
            </form>
          </div>
        </div>
        <p class="text-center text-body-secondary mt-3 small">Sistema para gestão de contribuições</p>
      </div>
    </div>
  </div>
</body>
</html>
