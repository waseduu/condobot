<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CondoBot - Relatórios</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container-fluid px-4 py-4">
    <h2 class="mb-4"><i class="bi bi-file-earmark-bar-graph me-2"></i>Relatório Mensal</h2>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <form method="GET" class="row g-2 align-items-end">
          <div class="col-8 col-md-4">
            <select name="mes" class="form-select">
              <% meses.forEach(m => { %>
                <option value="<%= m %>" <%= mesSelecionado === m ? 'selected' : '' %>><%= m %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-4 col-md-2">
            <button class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Ver</button>
          </div>
          <div class="col-4 col-md-2">
            <a href="/relatorios/exportar?mes=<%= mesSelecionado %>" class="btn btn-success w-100"><i class="bi bi-file-earmark-excel"></i> Excel</a>
          </div>
        </form>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Contribuições</small>
            <h4 class="mb-0"><%= totalPago %>/<%= totalContribuicoes %></h4>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Arrecadado</small>
            <h4 class="text-success mb-0"><%= valorArrecadado.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h4>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Despesas</small>
            <h4 class="text-danger mb-0"><%= totalSaidas.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h4>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <small class="text-body-secondary">Saldo</small>
            <h4 class="text-<%= saldo >= 0 ? 'success' : 'danger' %> mb-0"><%= saldo.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h4>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header d-flex justify-content-between">
            <span><i class="bi bi-currency-dollar text-success me-2"></i>Entradas</span>
            <span class="text-success"><%= totalEntradas.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></span>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead>
                <tr><th>Data</th><th>Descrição</th><th>Valor</th></tr>
              </thead>
              <tbody>
                <% if (entradas.length === 0) { %>
                  <tr><td colspan="3" class="text-center text-body-secondary py-3">Nenhuma entrada</td></tr>
                <% } %>
                <% entradas.forEach(e => { %>
                <tr>
                  <td><%= e.data %></td>
                  <td><%= e.descricao %></td>
                  <td class="text-success"><%= e.valor.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card shadow-sm">
          <div class="card-header d-flex justify-content-between">
            <span><i class="bi bi-currency-dollar text-danger me-2"></i>Saídas</span>
            <span class="text-danger"><%= totalSaidas.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></span>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
              <thead>
                <tr><th>Data</th><th>Descrição</th><th>Valor</th></tr>
              </thead>
              <tbody>
                <% if (saidas.length === 0) { %>
                  <tr><td colspan="3" class="text-center text-body-secondary py-3">Nenhuma saída</td></tr>
                <% } %>
                <% saidas.forEach(s => { %>
                <tr>
                  <td><%= s.data %></td>
                  <td><%= s.descricao %></td>
                  <td class="text-danger">-<%= s.valor.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm mt-4">
      <div class="card-header"><i class="bi bi-list-check me-2"></i>Contribuições do Mês</div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr><th>Morador</th><th>Lote</th><th>Valor</th><th>Status</th><th>Data</th></tr>
          </thead>
          <tbody>
            <% if (contribuicoes.length === 0) { %>
              <tr><td colspan="5" class="text-center text-body-secondary py-3">Nenhuma contribuição neste mês</td></tr>
            <% } %>
            <% contribuicoes.forEach(c => { %>
            <tr>
              <td><%= c.morador_nome %></td>
              <td><%= c.morador_lote %></td>
              <td><%= c.valor.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></td>
              <td>
                <span class="badge bg-<%= c.status === 'Pago' ? 'success' : 'warning' %>"><%= c.status %></span>
              </td>
              <td><%= c.data_pagamento || '-' %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
