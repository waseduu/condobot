<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CondoBot - Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>
  <div class="container-fluid px-4 py-4">
    <h2 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <i class="bi bi-people fs-2 text-primary"></i>
            <h3 class="mt-2 mb-0"><%= totalMoradores %></h3>
            <small class="text-body-secondary">Moradores</small>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <i class="bi bi-cash-stack fs-2 text-success"></i>
            <h3 class="mt-2 mb-0"><%= pagas %></h3>
            <small class="text-body-secondary">Pagamentos</small>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <i class="bi bi-clock-history fs-2 text-warning"></i>
            <h3 class="mt-2 mb-0"><%= pendentes %></h3>
            <small class="text-body-secondary">Pendentes</small>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <i class="bi bi-graph-up-arrow fs-2 text-info"></i>
            <h3 class="mt-2 mb-0"><%= totalContribuicoes %></h3>
            <small class="text-body-secondary">Total Contribuições</small>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-6 col-lg-3">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <i class="bi bi-wallet2 fs-2 text-success"></i>
            <h3 class="mt-2 mb-0"><%= arrecadado.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h3>
            <small class="text-body-secondary">Arrecadado</small>
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6 col-lg-12">
        <div class="card card-dash border-0 shadow-sm">
          <div class="card-body text-center">
            <i class="bi bi-piggy-bank fs-2 text-<%= saldoAtual >= 0 ? 'success' : 'danger' %>"></i>
            <h3 class="mt-2 mb-0"><%= saldoAtual.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></h3>
            <small class="text-body-secondary">Saldo Atual</small>
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-check me-2"></i>Últimas Contribuições</span>
        <a href="/contribuicoes" class="btn btn-sm btn-outline-primary">Ver todas</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Morador</th>
                <th>Mês</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Data Pagamento</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentes.length === 0) { %>
                <tr><td colspan="5" class="text-center text-body-secondary py-4">Nenhuma contribuição registrada</td></tr>
              <% } %>
              <% recentes.forEach(c => { %>
              <tr>
                <td><%= c.nome %></td>
                <td><%= c.mes_referencia %></td>
                <td><%= c.valor.toLocaleString('pt-BR', {style:'currency', currency:'BRL'}) %></td>
                <td>
                  <span class="badge bg-<%= c.status === 'Pago' ? 'success' : 'warning' %>">
                    <%= c.status %>
                  </span>
                </td>
                <td><%= c.data_pagamento || '-' %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
